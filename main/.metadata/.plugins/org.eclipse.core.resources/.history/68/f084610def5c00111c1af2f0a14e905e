#include <stdio.h>
#include <string.h>

#include "xparameters.h"
#include "netif/xadapter.h"
#include "platform.h"
#include "platform_config.h"

#include "xil_printf.h"
#include "xil_cache.h"
#include "xstatus.h"

/* lwIP */
#include "lwip/tcp.h"

/* HDMI */
#include "display_demo.h"

/* lwIP timers */
void tcp_fasttmr(void);
void tcp_slowtmr(void);
void lwip_init(void);

/* âœ… TCP server function */
int start_application(void);

/* Timer flags */
extern volatile int TcpFastTmrFlag;
extern volatile int TcpSlowTmrFlag;

/* Network interface */
static struct netif server_netif;
struct netif *echo_netif;

/* ================= DDR CLEAR ================= */

#define FB_BASE  0x10000000U
#define FB_SIZE  0x06000000
  // 32MB safe region

static void clear_ddr()
{
    memset((void*)FB_BASE, 0x00, FB_SIZE);
    Xil_DCacheFlushRange((UINTPTR)FB_BASE, FB_SIZE);
    xil_printf("DDR cleared âœ…\r\n");
}

/* ================= MAIN ================= */
int main()
{
    ip_addr_t ipaddr, netmask, gw;

    /* MAC address */
    unsigned char mac_ethernet_address[] =
    { 0x00, 0x0A, 0x35, 0x00, 0x01, 0x02 };

    echo_netif = &server_netif;

    /* Platform init */
    init_platform();

    xil_printf("\n=== HDMI STREAM SYSTEM (RGB888) ===\r\n");

    /* ================= HDMI INIT ================= */
    if (HDMI_Init() != XST_SUCCESS) {
        xil_printf("HDMI INIT FAILED â�Œ\r\n");
        return -1;
    }

    /* ================= CLEAR DDR ================= */
    clear_ddr();

    /* ================= LWIP INIT ================= */
    lwip_init();

    /* Static IP */
    IP4_ADDR(&ipaddr, 192,168,1,10);
    IP4_ADDR(&netmask, 255,255,255,0);
    IP4_ADDR(&gw, 192,168,1,1);

    /* Add network interface */
    if (!xemac_add(echo_netif,
                   &ipaddr,
                   &netmask,
                   &gw,
                   mac_ethernet_address,
                   PLATFORM_EMAC_BASEADDR))
    {
        xil_printf("ERROR: Failed to add network interface\r\n");
        return -1;
    }

    netif_set_default(echo_netif);

    /* âœ… IMPORTANT: enable interrupts */
    platform_enable_interrupts();

    netif_set_up(echo_netif);

    xil_printf("IP Address: 192.168.1.10 âœ…\r\n");

    /* ================= START TCP SERVER ================= */
    start_application();

    /* ================= MAIN LOOP ================= */
    while (1)
    {
        /* lwIP timers */
        if (TcpFastTmrFlag) {
            tcp_fasttmr();
            TcpFastTmrFlag = 0;
        }

        if (TcpSlowTmrFlag) {
            tcp_slowtmr();
            TcpSlowTmrFlag = 0;
        }

        /* Process incoming packets */
        xemacif_input(echo_netif);
    }

    cleanup_platform();

    return 0;
}
