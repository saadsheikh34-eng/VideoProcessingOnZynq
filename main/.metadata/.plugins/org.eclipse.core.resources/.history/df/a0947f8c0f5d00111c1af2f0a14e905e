#include <stdio.h>
#include "xil_types.h"
#include "xparameters.h"
#include "xil_cache.h"
#include "xil_printf.h"
#include "xstatus.h"

#include "display_demo.h"
#include "display_ctrl/display_ctrl.h"
#include "display_ctrl/vga_modes.h"

/* Hardware IDs */
#define DYNCLK_BASEADDR     XPAR_AXI_DYNCLK_0_BASEADDR
#define VGA_VDMA_ID         XPAR_AXIVDMA_0_DEVICE_ID
#define DISP_VTC_ID         XPAR_VTC_0_DEVICE_ID

/* Global display controller */
DisplayCtrl dispCtrl;
XAxiVdma vdma;

/* ✅ TRIPLE BUFFER FOR SMOOTH VIDEO */
#define FB1 0x10000000
#define FB2 0x12000000
#define FB3 0x14000000

#define NUM_FRAMES 3
u8 *pFrames[NUM_FRAMES];

/* ================= HDMI INIT ================= */
int HDMI_Init()
{
    int Status;
    XAxiVdma_Config *vdmaConfig;

    xil_printf("\n=== Initializing HDMI 720p (3-Buffer Circular) ===\r\n");

    /* ✅ assign buffers */
    pFrames[0] = (u8 *)FB1;
    pFrames[1] = (u8 *)FB2;
    pFrames[2] = (u8 *)FB3;

    /* ✅ initialize VDMA */
    vdmaConfig = XAxiVdma_LookupConfig(VGA_VDMA_ID);
    if (!vdmaConfig) {
        xil_printf("VDMA lookup failed ❌\r\n");
        return XST_FAILURE;
    }

    Status = XAxiVdma_CfgInitialize(&vdma,
                                   vdmaConfig,
                                   vdmaConfig->BaseAddress);
    if (Status != XST_SUCCESS) {
        xil_printf("VDMA init failed ❌\r\n");
        return XST_FAILURE;
    }

    /* ✅ SELECT 720p MODE */
    VideoMode VMODE = VMODE_1280x720;

    /* ✅ initialize display */
    Status = DisplayInitialize(&dispCtrl,
                               &vdma,
                               DISP_VTC_ID,
                               DYNCLK_BASEADDR,
                               pFrames,
                               1280 * 4,   // ✅ CORRECT STRIDE
                               VMODE);

    if (Status != XST_SUCCESS) {
        xil_printf("Display init failed ❌\r\n");
        return XST_FAILURE;
    }

    /* ✅ CRITICAL: ENABLE CIRCULAR BUFFER */
    dispCtrl.vdmaConfig.EnableCircularBuf = 1;

    /* ✅ reduce frame delay (important for smoother switching) */
    dispCtrl.vdmaConfig.FrameDelay = 0;

    /* ✅ ensure frame store = 3 */

    dispCtrl.vdmaConfig.FrameStoreStartAddr[0] = (UINTPTR)FB1;
    dispCtrl.vdmaConfig.FrameStoreStartAddr[1] = (UINTPTR)FB2;
    dispCtrl.vdmaConfig.FrameStoreStartAddr[2] = (UINTPTR)FB3;

    /* ✅ start HDMI output */
    Status = DisplayStart(&dispCtrl);
    if (Status != XST_SUCCESS) {
        xil_printf("Display start failed ❌\r\n");
        return XST_FAILURE;
    }

    /* ✅ start VDMA in circular read mode */

    xil_printf("HDMI READY ✅ (720p Stable Output)\r\n");

    return XST_SUCCESS;
}
