#include <stdio.h>
#include <string.h>

#include "lwip/udp.h"
#include "lwip/ip_addr.h"

#include "xil_printf.h"
#include "xil_cache.h"

#include "display_demo.h"
#include "display_ctrl/display_ctrl.h"

/* ========================================================= */
/* VIDEO CONFIG                                              */
/* ========================================================= */
#define WIDTH       640
#define HEIGHT      480
#define BPP         4

#define FRAME_SIZE  (WIDTH * HEIGHT * BPP)

/* ========================================================= */
/* FRAME BUFFERS                                             */
/* ========================================================= */
#define FB1 0x10000000U
#define FB2 0x10200000U
#define FB3 0x10400000U

static u32 fb_list[3] =
{
    FB1,
    FB2,
    FB3
};

extern DisplayCtrl dispCtrl;

/* ========================================================= */
/* RECEIVE STATE                                             */
/* ========================================================= */
static u32 offset = 0;
static int write_index = 2;

/* ========================================================= */
/* UDP RECEIVE CALLBACK                                      */
/* ========================================================= */
void udp_recv_callback(void *arg,
                       struct udp_pcb *pcb,
                       struct pbuf *p,
                       const ip_addr_t *addr,
                       u16_t port)
{
    (void)arg;
    (void)pcb;
    (void)addr;
    (void)port;

    if (!p) return;

    struct pbuf *q = p;

    while (q != NULL)
    {
        u8 *payload = (u8 *)q->payload;
        u32 remaining = q->len;
        u32 payload_offset = 0;

        while (remaining > 0)
        {
            u32 fb_addr = fb_list[write_index];
            u8 *fb = (u8 *)fb_addr;

            u32 space_left = FRAME_SIZE - offset;

            u32 bytes_to_copy =
                (remaining < space_left) ?
                remaining :
                space_left;

            memcpy(&fb[offset],
                   &payload[payload_offset],
                   bytes_to_copy);

            offset += bytes_to_copy;
            payload_offset += bytes_to_copy;
            remaining -= bytes_to_copy;

            /* ✅ FULL FRAME COMPLETE */
            if (offset == FRAME_SIZE)
            {
                Xil_DCacheFlushRange(
                    (UINTPTR)fb_addr,
                    FRAME_SIZE);

                xil_printf(
                    "Frame -> FB%d\r\n",
                    write_index + 1);

                /* ✅ Display frame */
                DisplayChangeFrame(
                    &dispCtrl,
                    write_index);

                /* ✅ Safe buffer selection */
                int display_index = dispCtrl.curFrame;
                write_index = (display_index + 2) % 3;

                offset = 0;
            }
        }

        q = q->next;
    }

    pbuf_free(p);
}

/* ========================================================= */
/* START UDP SERVER                                          */
/* ========================================================= */
int start_application(void)
{
    struct udp_pcb *pcb;

    pcb = udp_new();
    if (!pcb)
    {
        xil_printf("UDP PCB create failed\r\n");
        return -1;
    }

    if (udp_bind(pcb, IP_ANY_TYPE, 6001) != ERR_OK)
    {
        xil_printf("UDP bind failed\r\n");
        return -1;
    }

    udp_recv(pcb, udp_recv_callback, NULL);

    xil_printf("UDP Video Server Ready @ Port 6001\r\n");
    xil_printf("Resolution : %dx%d\r\n", WIDTH, HEIGHT);
    xil_printf("Frame Size : %u bytes\r\n", FRAME_SIZE);

    return 0;
}
