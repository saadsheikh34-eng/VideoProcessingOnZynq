#include <stdio.h>
#include <string.h>

#include "lwip/err.h"
#include "lwip/tcp.h"

#include "xil_printf.h"
#include "xil_cache.h"

#include "display_demo.h"
#include "display_ctrl/display_ctrl.h"

/* ========================================================= */
/* VIDEO CONFIG                                              */
/* ========================================================= */
#define WIDTH       1280
#define HEIGHT      720
#define BPP         4

#define FRAME_SIZE  (WIDTH * HEIGHT * BPP)

/* ========================================================= */
/* FRAME BUFFERS                                             */
/* ========================================================= */
#define FB1 0x10000000U
#define FB2 0x10200000U
#define FB3 0x10400000U

static u32 fb_list[3] =
{
    FB1,
    FB2,
    FB3
};

extern DisplayCtrl dispCtrl;

/* ========================================================= */
/* RECEIVE STATE                                             */
/* ========================================================= */

/* Current write position inside frame */
static u32 offset = 0;

/* Buffer currently being written */
static int write_index = 2;

/* ========================================================= */
/* RECEIVE CALLBACK                                          */
/* ========================================================= */
err_t recv_callback(void *arg,
                    struct tcp_pcb *tpcb,
                    struct pbuf *p,
                    err_t err)
{
    (void)arg;
    (void)err;

    if (p == NULL)
    {
        xil_printf("Client disconnected\r\n");

        tcp_close(tpcb);
        tcp_recv(tpcb, NULL);

        return ERR_OK;
    }

    tcp_recved(tpcb, p->tot_len);

    struct pbuf *q = p;

    while (q != NULL)
    {
        u8 *payload = (u8 *)q->payload;
        u32 remaining = q->len;
        u32 payload_offset = 0;

        while (remaining > 0)
        {
            u32 fb_addr = fb_list[write_index];
            u8 *fb = (u8 *)fb_addr;

            u32 space_left = FRAME_SIZE - offset;

            u32 bytes_to_copy =
                (remaining < space_left) ?
                remaining :
                space_left;

            memcpy(&fb[offset],
                   &payload[payload_offset],
                   bytes_to_copy);

            offset += bytes_to_copy;
            payload_offset += bytes_to_copy;
            remaining -= bytes_to_copy;

            /* COMPLETE FRAME RECEIVED */
            if (offset >= FRAME_SIZE)
            {
                Xil_DCacheFlushRange(
                    (UINTPTR)fb_addr,
                    FRAME_SIZE);

                xil_printf(
                    "Frame complete -> FB%d\r\n",
                    write_index + 1);

                /* Tell display to show newly completed frame */
                DisplayChangeFrame(
                    &dispCtrl,
                    write_index);

                /* Select next safe buffer */
                {
                    int display_index =
                        dispCtrl.curFrame;

                    write_index =
                        (display_index + 2) % 3;
                }

                offset = 0;
            }
        }

        q = q->next;
    }

    pbuf_free(p);

    return ERR_OK;
}

/* ========================================================= */
/* ACCEPT CALLBACK                                           */
/* ========================================================= */
err_t accept_callback(void *arg,
                      struct tcp_pcb *newpcb,
                      err_t err)
{
    (void)arg;
    (void)err;

    tcp_recv(newpcb, recv_callback);

    xil_printf("Client connected\r\n");

    return ERR_OK;
}

/* ========================================================= */
/* START APPLICATION                                          */
/* ========================================================= */
int start_application(void)
{
    struct tcp_pcb *pcb;

    pcb = tcp_new_ip_type(IPADDR_TYPE_ANY);

    if (pcb == NULL)
    {
        xil_printf("TCP PCB alloc failed\r\n");
        return -1;
    }

    if (tcp_bind(pcb,
                 IP_ANY_TYPE,
                 6001) != ERR_OK)
    {
        xil_printf("TCP bind failed\r\n");
        return -1;
    }

    pcb = tcp_listen(pcb);

    if (pcb == NULL)
    {
        xil_printf("TCP listen failed\r\n");
        return -1;
    }

    tcp_accept(
        pcb,
        accept_callback);

    xil_printf(
        "TCP Video Server Ready @ Port 6001\r\n");

    xil_printf(
        "Resolution : %dx%d\r\n",
        WIDTH,
        HEIGHT);

    xil_printf(
        "Frame Size : %u bytes\r\n",
        FRAME_SIZE);

    return 0;
}
